# --- LOCAL (SQLite) ---
# DATABASE_URL="file:/absolute/path/to/prisma/dev.db"
# TURSO_AUTH_TOKEN=   # dejar vacío en local

# --- PRODUCCIÓN (Turso) ---
DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# WhatsApp (número sin +, ej: 5493812345678 para Tucumán)
# Hasta 4 contactos: al confirmar el pedido, el cliente elige a quién enviarlo.
# WHATSAPP_NAME(_N) es el nombre que se muestra en el selector (opcional).
WHATSAPP_NUMBER="5493812345678"
WHATSAPP_NAME="Tobias"
# WHATSAPP_NUMBER_2=""
# WHATSAPP_NAME_2=""
# WHATSAPP_NUMBER_3=""
# WHATSAPP_NAME_3=""
# WHATSAPP_NUMBER_4=""
# WHATSAPP_NAME_4=""

# Admin login — secret used to sign the admin session cookie (JWT).
# Falls back to NEXTAUTH_SECRET if unset. Generate with: openssl rand -base64 32
SESSION_SECRET="generate-a-random-string"

# Admin credentials seeded by `npm run db:seed` (the password is hashed before storing).
ADMIN_EMAIL="admin@tobias.com"
ADMIN_PASSWORD="change-me"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-string"
NEXTAUTH_URL="https://your-app.vercel.app"

# Vercel Blob (image uploads in production)
# Get this from: Vercel dashboard → Storage → Blob → Connect store → .env.local
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Borgest sync — shared secret required in the x-api-key header on POST /api/sync-productos
SYNC_API_KEY="generate-a-long-random-string"

# Bot de WhatsApp (ChatNoa) — al confirmar un pedido que vino del botón CTA de WhatsApp
# (?pedido=... en la URL), le avisamos a POST {BOT_BASE_URL}/api/pedido-confirmado para
# que mande el desglose directo por WhatsApp, en vez de depender de que el cliente abra
# wa.me a mano. Es server-to-server: el secreto nunca sale al browser.
#
# TOBIAS_PEDIDO_WEBHOOK_TOKEN tiene que ser EL MISMO VALOR EXACTO que la variable
# homónima en el .env del bot, si no el bot responde 401.
BOT_BASE_URL="https://tu-deploy-del-bot.vercel.app"
TOBIAS_PEDIDO_WEBHOOK_TOKEN="generate-a-long-random-string"

# Alias aceptados por compatibilidad con el deploy actual (si están seteadas las de
# arriba, estas se ignoran). Al migrar el deploy a los nombres de arriba, se borran.
# CHATNOA_BOT_URL=""
# CHATNOA_PEDIDO_WEBHOOK_TOKEN=""
